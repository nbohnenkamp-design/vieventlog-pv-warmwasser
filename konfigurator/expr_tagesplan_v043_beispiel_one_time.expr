// Community-PV-Warmwasser V0.4.3 – DAUERHAFTER TAGESPLAN, KEINE GERAETEAKTION
// Beide Ausloeseverfahren: schedule (ViCare-Zeitprogramm) oder one_time (Einmalladung).
// Diese Version speichert NUR einen Skriptstatus; sie schaltet die Anlage NICHT.
// In ViEventLog-TESTLAEUFEN wird set() nicht dauerhaft gespeichert.
// Bei regulaerem Lauf schreibt set() den Tagesplan in den Zustand DIESER Skript-ID.
// Vor dem ersten regulaeren Lauf den Testlauf und die Einstellungen kontrollieren.
// Keine setDhwTemperature(), startDhwOneTimeCharge() oder /api/schedule/set.

// ===== EINSTELLUNGEN AUS DEM HTML-KONFIGURATOR =====
let WW_TESTMODUS = true; // Geraeteaktionen sind im Code grundsaetzlich nicht enthalten.
let WW_PLAN_SPEICHERN = true; // Nur lokaler ViEventLog-Skriptzustand, KEINE ViCare-Aktion.
let WW_AUSLOESEWEG = "one_time"; // "one_time" oder "schedule"
let WW_AUTOMATIK_AKTIV = true;
let WW_MORGEN_AKTIV = true;
let WW_TAGESLADUNG_AKTIV = true;
let WW_MORGEN_UHR = "06:00";
let WW_MORGEN_FENSTER_MIN = 15;
let WW_MORGEN_UNTER_C = 39;
let WW_MORGEN_ZIEL_C = 45;
let WW_TAGES_ZIEL_C = 51;
let PV_BEGINN = "10:00";
let PV_ENDE = "16:00";
let PV_MIN_WERT = 70;
let WW_FALLBACK = "manual_latest";
let PV_QUELLE = "openmeteo";

// ===== ZEIT, ISTWERTE UND PLAN AUS VORHERIGEN LAEUFEN =====
let WW_JETZT = date(now().Unix(), "", "Europe/Berlin");
let WW_HEUTE = WW_JETZT.Format("2006-01-02");
let WW_UNIX = now().Unix();
let WW_LAYOUT = "2006-01-02T15:04";
let WW_IST = dhwTemp();
let WW_SOLL = dhwTarget();
let WW_IST_OK = WW_IST != nil && (type(WW_IST) == "int" || type(WW_IST) == "float") && WW_IST >= 5 && WW_IST <= 80;
let PV_START_DATUM = date(WW_HEUTE + "T" + PV_BEGINN, WW_LAYOUT, "Europe/Berlin");
let PV_ENDE_DATUM = date(WW_HEUTE + "T" + PV_ENDE, WW_LAYOUT, "Europe/Berlin");
let PV_START_UNIX = PV_START_DATUM == nil ? -1 : PV_START_DATUM.Unix();
let PV_ENDE_UNIX = PV_ENDE_DATUM == nil ? -1 : PV_ENDE_DATUM.Unix();
let WW_MORGEN_DATUM = date(WW_HEUTE + "T" + WW_MORGEN_UHR, WW_LAYOUT, "Europe/Berlin");
let WW_MORGEN_UNIX = WW_MORGEN_DATUM == nil ? -1 : WW_MORGEN_DATUM.Unix();
let WW_EINSTELLUNGEN_OK = WW_AUSLOESEWEG in ["schedule", "one_time"] &&
  PV_START_UNIX > 0 && PV_ENDE_UNIX > PV_START_UNIX &&
  PV_MIN_WERT >= 0 && PV_MIN_WERT <= 1600 &&
  WW_TAGES_ZIEL_C >= 30 && WW_TAGES_ZIEL_C <= 70 &&
  WW_MORGEN_UNIX > 0 && WW_MORGEN_FENSTER_MIN >= 5 && WW_MORGEN_FENSTER_MIN <= 60 &&
  WW_MORGEN_UNTER_C >= 5 && WW_MORGEN_UNTER_C <= 70 &&
  WW_MORGEN_ZIEL_C >= 30 && WW_MORGEN_ZIEL_C <= 70 &&
  WW_FALLBACK in ["manual_latest", "hold"];

// Eine EINZIGE Status-Map: kein teilweises Ersetzen mehrerer einzelner Status-Keys.
// Unbekannte / unvollstaendige Statusdaten blockieren sicherheitshalber eine Neuplanung.
let WW_PLAN = get("community_ww_plan_v043", nil);
let WW_HAT_PLAN = WW_PLAN != nil;
let WW_PLAN_SCHEMA_OK = !WW_HAT_PLAN || (
  WW_PLAN?.schema == 1 && type(WW_PLAN?.day) == "string" &&
  WW_PLAN?.source in ["fallback", "openmeteo"] &&
  WW_PLAN?.method in ["schedule", "one_time"] &&
  (type(WW_PLAN?.startUnix) == "int" || type(WW_PLAN?.startUnix) == "float") &&
  WW_PLAN?.startUnix > 0 &&
  (type(WW_PLAN?.createdUnix) == "int" || type(WW_PLAN?.createdUnix) == "float") &&
  WW_PLAN?.createdUnix > 0 &&
  WW_PLAN?.mainStatus in ["planned", "requested", "running", "pending", "unknown", "done", "completed"] &&
  WW_PLAN?.morningStatus in ["none", "requested", "running", "pending", "unknown", "done", "completed"]
);
let WW_PLAN_HEUTE = WW_HAT_PLAN && WW_PLAN_SCHEMA_OK && WW_PLAN?.day == WW_HEUTE;
let WW_PLAN_ALT = WW_HAT_PLAN && WW_PLAN_SCHEMA_OK && WW_PLAN?.day != WW_HEUTE;
let WW_ALTER_AUFTRAG_UNKLAR = WW_PLAN_ALT && (
  WW_PLAN?.mainStatus in ["requested", "running", "pending", "unknown"] ||
  WW_PLAN?.morningStatus in ["requested", "running", "pending", "unknown"]
);
// Beim Wechsel von schedule auf one_time (oder Aenderung relevanter Einstellungen)
// am GLEICHEN Tag den alten Tagesplan nicht stillschweigend ueberschreiben.
let WW_PLAN_KONFLIKT = WW_PLAN_HEUTE && (
  WW_PLAN?.method != WW_AUSLOESEWEG ||
  WW_PLAN?.pvBegin != PV_BEGINN || WW_PLAN?.pvEnd != PV_ENDE ||
  WW_PLAN?.solarMin != PV_MIN_WERT || WW_PLAN?.fallback != WW_FALLBACK ||
  WW_PLAN?.mainTarget != WW_TAGES_ZIEL_C ||
  WW_PLAN?.morningEnabled != WW_MORGEN_AKTIV ||
  WW_PLAN?.morningTime != WW_MORGEN_UHR ||
  WW_PLAN?.morningBelow != WW_MORGEN_UNTER_C ||
  WW_PLAN?.morningTarget != WW_MORGEN_ZIEL_C ||
  WW_PLAN?.morningWindow != WW_MORGEN_FENSTER_MIN
);
let WW_NEUPLANUNG_ERLAUBT = WW_EINSTELLUNGEN_OK && WW_AUTOMATIK_AKTIV &&
  WW_TAGESLADUNG_AKTIV && WW_PLAN_SCHEMA_OK && !WW_PLAN_HEUTE &&
  !WW_ALTER_AUFTRAG_UNKLAR && PV_ENDE_UNIX > WW_UNIX;

// Mindestvorlauf NUR bei erstmaliger Planung. Nach set() bleibt der Start fest.
// ViCare-Zeitprogramm: wenigstens 10 Minuten, immer auf 10-Minuten-Raster.
// Einmalladung: naechste 10-Minuten-Grenze als Vorschlag (kein Vorlaufzwang).
let WW_VORLAUF_UNIX = WW_AUSLOESEWEG == "schedule" ? WW_UNIX + 600 : WW_UNIX;
let WW_ERSTE_PLANMINUTE = int(ceil(float(WW_VORLAUF_UNIX) / 600.0) * 600.0);
let PV_FRUEHEST = max(PV_START_UNIX, WW_ERSTE_PLANMINUTE);

// Open-Meteo ausschliesslich bei NEUPLANUNG abrufen. Bereits gespeicherte
// Tagesplaene bleiben auch bei neuem Wetter oder Netzproblemen unveraendert.
// Berlin ist lediglich ein Beispielstandort aus dem Konfigurator.
let PV_ANTWORT = WW_NEUPLANUNG_ERLAUBT ? httpGet("https://api.open-meteo.com/v1/forecast?latitude=52.5200&longitude=13.4050&hourly=global_tilted_irradiance&timezone=Europe%2FBerlin&forecast_days=2&tilt=30&azimuth=0") : nil;
let PV_ZEITEN = jsonPath(PV_ANTWORT, "hourly.time");
let PV_WERTE = jsonPath(PV_ANTWORT, "hourly.global_tilted_irradiance");
let PV_DATEN_OK = type(PV_ZEITEN) == "array" && type(PV_WERTE) == "array" &&
  len(PV_ZEITEN) > 0 && len(PV_ZEITEN) <= 192 && len(PV_ZEITEN) == len(PV_WERTE) &&
  jsonPath(PV_ANTWORT, "timezone") == "Europe/Berlin";

// Open-Meteo-Stundenwert beschreibt die VORHERIGE Stunde.
let PV_KANDIDATEN = PV_DATEN_OK && PV_ENDE_UNIX >= PV_FRUEHEST ?
  filter(map(0..(len(PV_ZEITEN) - 1), {
    let i = #;
    let wert = PV_WERTE[i];
    let istZahl = type(wert) == "int" || type(wert) == "float";
    let zeit = type(PV_ZEITEN[i]) == "string" ?
      date(PV_ZEITEN[i], WW_LAYOUT, "Europe/Berlin") : nil;
    let ende = zeit == nil ? -1 : zeit.Unix();
    let start = max(ende - 3600, PV_FRUEHEST);
    {startUnix: start, score: wert, gueltig: istZahl && wert >= 0 && wert <= 1600 &&
      zeit != nil && start < ende && start < PV_ENDE_UNIX && wert >= PV_MIN_WERT && wert > 0}
  }), .gueltig) : [];
let PV_SORTIERT = len(PV_KANDIDATEN) > 0 ? sortBy(PV_KANDIDATEN, .score) : [];
let PV_BESTWERT = len(PV_SORTIERT) > 0 ? PV_SORTIERT[-1].score : nil;
let PV_GLEICH = PV_BESTWERT == nil ? [] : filter(PV_KANDIDATEN, .score == PV_BESTWERT);
let PV_BEST = len(PV_GLEICH) > 0 ? sortBy(PV_GLEICH, .startUnix)[0] : nil;
let PV_ERSETZUNG = PV_BEST == nil && WW_FALLBACK == "manual_latest" &&
  PV_ENDE_UNIX >= PV_FRUEHEST ? PV_ENDE_UNIX : -1;
let PV_VORSCHLAG_UNIX = PV_BEST == nil ? PV_ERSETZUNG : PV_BEST.startUnix;
let PV_VORSCHLAG_QUELLE = PV_BEST == nil ? "fallback" : "openmeteo";
let WW_NEUER_PLAN_GUELTIG = WW_NEUPLANUNG_ERLAUBT && PV_VORSCHLAG_UNIX > 0;

// Plan-Record wird einmal pro Tag angelegt, danach nur noch GELESEN.
// "planned" beschreibt eine Planungsabsicht, keine ausgefuehrte WW-Aktion.
// In ViEventLog-TESTLAEUFEN gibt es laut Skript-Engine KEINE dauerhafte Speicherung.
// In regulaeren Laeufen ist dies die EINZIGE set()-Stelle im Skript.
if WW_NEUER_PLAN_GUELTIG && WW_PLAN_SPEICHERN {
  set("community_ww_plan_v043", {
    schema: 1, day: WW_HEUTE, method: WW_AUSLOESEWEG,
    startUnix: PV_VORSCHLAG_UNIX, source: PV_VORSCHLAG_QUELLE,
    createdUnix: WW_UNIX,
    mainStatus: "planned", morningStatus: "none",
    pvBegin: PV_BEGINN, pvEnd: PV_ENDE, solarMin: PV_MIN_WERT,
    fallback: WW_FALLBACK, mainTarget: WW_TAGES_ZIEL_C,
    morningEnabled: WW_MORGEN_AKTIV, morningTime: WW_MORGEN_UHR,
    morningWindow: WW_MORGEN_FENSTER_MIN,
    morningBelow: WW_MORGEN_UNTER_C, morningTarget: WW_MORGEN_ZIEL_C
  });
  log("PLAN_NEU: Tagesplan per set() vorgemerkt; nur regulaere Laeufe speichern dauerhaft.")
} else { false };

// In demselben Lauf bereits den geplanten Wert anzeigen. Bei einem Testlauf
// ist der Wert nur simuliert; erst ein spaeterer Lauf mit get() bestaetigt Speicherung.
let WW_AKTIVER_START = WW_PLAN_HEUTE && !WW_PLAN_KONFLIKT ? WW_PLAN?.startUnix :
  (WW_NEUER_PLAN_GUELTIG ? PV_VORSCHLAG_UNIX : -1);
let WW_AKTIVE_METHODE = WW_PLAN_HEUTE ? WW_PLAN?.method : WW_AUSLOESEWEG;
let WW_AKTIVER_STATUS = WW_PLAN_HEUTE ? WW_PLAN?.mainStatus :
  (WW_NEUER_PLAN_GUELTIG ? "planned_preview" : "none");
let WW_TAG_BEDARF = WW_AUTOMATIK_AKTIV && WW_TAGESLADUNG_AKTIV &&
  WW_IST_OK && WW_IST < WW_TAGES_ZIEL_C;
let WW_FENSTER_ERREICHT = WW_AKTIVER_START > 0 &&
  WW_UNIX >= WW_AKTIVER_START && WW_UNIX <= WW_AKTIVER_START + 900;
let WW_TERMIN_VERPASST = WW_AKTIVER_START > 0 && WW_UNIX > WW_AKTIVER_START + 900;
let WW_ZEITPROGRAMM_NOCH_EDITIERBAR = WW_AKTIVER_START > 0 &&
  WW_AKTIVER_START >= WW_UNIX + 600;
let WW_MORGENFENSTER = WW_MORGEN_UNIX > 0 && WW_UNIX >= WW_MORGEN_UNIX &&
  WW_UNIX < WW_MORGEN_UNIX + WW_MORGEN_FENSTER_MIN * 60;
let WW_MORGENBEDARF = WW_AUTOMATIK_AKTIV && WW_MORGEN_AKTIV &&
  WW_IST_OK && WW_IST < WW_MORGEN_UNTER_C && WW_MORGENFENSTER;
let WW_UNGEWISS = WW_PLAN_HEUTE &&
  (WW_PLAN?.mainStatus in ["requested", "running", "pending", "unknown"] ||
   WW_PLAN?.morningStatus in ["requested", "running", "pending", "unknown"]);
let WW_MORGEN_BEREITS = WW_PLAN_HEUTE && WW_PLAN?.morningStatus in ["done", "completed"];
let WW_MAIN_BEREITS = WW_PLAN_HEUTE && WW_PLAN?.mainStatus in ["done", "completed"];
let WW_MORGEN_DIAGNOSE = WW_MORGENBEDARF && !WW_UNGEWISS && !WW_MORGEN_BEREITS &&
  WW_PLAN_SCHEMA_OK && !WW_PLAN_KONFLIKT && !WW_ALTER_AUFTRAG_UNKLAR;
let WW_EINMAL_DIAGNOSE = WW_AKTIVE_METHODE == "one_time" &&
  WW_PLAN_HEUTE && !WW_PLAN_KONFLIKT && !WW_UNGEWISS && !WW_MAIN_BEREITS &&
  WW_AKTIVER_STATUS == "planned" && WW_TAG_BEDARF && WW_FENSTER_ERREICHT;
let WW_ZEITPLAN_DIAGNOSE = WW_AKTIVE_METHODE == "schedule" &&
  WW_PLAN_HEUTE && !WW_PLAN_KONFLIKT && !WW_UNGEWISS && !WW_MAIN_BEREITS &&
  WW_AKTIVER_STATUS == "planned" && WW_TAG_BEDARF && WW_ZEITPROGRAMM_NOCH_EDITIERBAR;

log("TEST V0.4.3: Tagesplan+Status; nur Skriptzustand, KEINE Anlagenaktion.");
log("Speichertemperatur", WW_IST ?? "unbekannt", "Sollwert", WW_SOLL ?? "unbekannt");
log("WW-Verfahren", WW_AUSLOESEWEG, "Konfiguration OK", WW_EINSTELLUNGEN_OK);
log("Statusdaten OK", WW_PLAN_SCHEMA_OK, "heutiger gespeicherter Plan", WW_PLAN_HEUTE,
    "Konfigurationskonflikt", WW_PLAN_KONFLIKT, "alter Auftrag ungeklaert", WW_ALTER_AUFTRAG_UNKLAR);
log("Open-Meteo nur bei Neuplanung: abgefragt", WW_NEUPLANUNG_ERLAUBT,
    "Daten gueltig", PV_DATEN_OK, "Kandidaten", len(PV_KANDIDATEN));
if WW_AKTIVER_START > 0 {
  log("PLAN:", date(WW_AKTIVER_START, "", "Europe/Berlin").Format("2006-01-02 15:04"),
      "Methode", WW_AKTIVE_METHODE, "Status", WW_AKTIVER_STATUS)
} else {
  log("KEIN TAGESPLAN: Wetter/Zeitraum/Einstellungen oder Status pruefen")
};
log("DIAGNOSE: Tagesbedarf", WW_TAG_BEDARF,
    "Einmalladung Zeitfenster erreicht", WW_EINMAL_DIAGNOSE,
    "Zeitprogramm neu editierbar", WW_ZEITPLAN_DIAGNOSE,
    "Morgenreserve moeglich", WW_MORGEN_DIAGNOSE,
    "Termin verpasst", WW_TERMIN_VERPASST);
log("STATUS: planned bedeutet nur berechnet, NICHT in ViCare eingestellt/gestartet.");
log("KEINE GERAETEAKTION: Kein Einmalstart, keine Zeitprogramm-Aenderung, keine Temperatur-Aenderung.");
false
