// Community-PV-Warmwasser V0.4.2 – PROGNOSEPLANER, NUR LESEN
// Basierend auf der getrennt entwickelten Synology-App Zappi · ViEventLog V0.4.47.
// Cron-Vorschlag: 0,30 * * * *  (ViEventLog-Zeitzone Europe/Berlin prüfen).
// Enthält absichtlich KEINE set()-Zustandsspeicherung und KEINE Anlagenaktionen.
// Externe Wetterdaten werden mit httpGet() gelesen.
// Dies ist keine produktive WW-Automatik. Tagesstatus wird NUR GELESEN.
let WW_TESTMODUS = true;
// Auswahl der späteren Auslösung, KEINE Aktion in diesem Lesetest.
let WW_AUSLOESEWEG = "schedule";
let WW_AUTOMATIK_AKTIV = true;
let WW_MORGEN_AKTIV = true;
let WW_TAGESLADUNG_AKTIV = true;
let WW_MORGEN_UHR = "06:00";
let WW_MORGEN_FENSTER_MIN = 15;
let WW_MORGEN_UNTER_C = 39;
let WW_MORGEN_ZIEL_C = 45;
let WW_TAGES_ZIEL_C = 51;
let PV_BEGINN = "10:00";
let PV_ENDE = "16:00";
let PV_QUELLE = "openmeteo";
let PV_MIN_WERT = 70;
let WW_FALLBACK = "manual_latest";
let WW_IST = dhwTemp();
let WW_SOLL = dhwTarget();
let WW_JETZT = date(now().Unix(), "", "Europe/Berlin");
let WW_HEUTE = WW_JETZT.Format("2006-01-02");
let WW_UNIX = now().Unix();
let WW_DATUM_LAYOUT = "2006-01-02T15:04";
let PV_START_DATUM = date(WW_HEUTE + "T" + PV_BEGINN, WW_DATUM_LAYOUT, "Europe/Berlin");
let PV_ENDE_DATUM = date(WW_HEUTE + "T" + PV_ENDE, WW_DATUM_LAYOUT, "Europe/Berlin");
let PV_START_UNIX = PV_START_DATUM == nil ? -1 : PV_START_DATUM.Unix();
let PV_ENDE_UNIX = PV_ENDE_DATUM == nil ? -1 : PV_ENDE_DATUM.Unix();
// Fester Tagesbezug: der gewaehlte Slot wandert NICHT mit jedem Durchlauf +10 Minuten.
// 10-Minuten-Vorlauf wird nur getrennt fuer eine NEUE Zeitplan-Schreibung bewertet.
let PV_FRUEHEST = PV_START_UNIX;
let PV_SCHREIB_VORLAUF_UNIX = int(ceil(float(WW_UNIX + 600) / 600.0) * 600.0);
log("TEST V0.4.2: feste Tagesplanung, nur LESEN. Keine Anlagenaktion.");
log("Speichertemperatur", WW_IST ?? "nicht lesbar", "Sollwert", WW_SOLL ?? "nicht lesbar");
log("Konfiguriertes WW-Verfahren", WW_AUSLOESEWEG, "(nur Lesevorschau)");
let WW_MORGEN_MINUTE = 360;
let WW_MINUTE_JETZT = WW_JETZT.Hour() * 60 + WW_JETZT.Minute();
let WW_MORGEN_NOETIG = WW_AUTOMATIK_AKTIV && WW_MORGEN_AKTIV &&
  WW_IST != nil && (type(WW_IST) == "int" || type(WW_IST) == "float") &&
  WW_IST < WW_MORGEN_UNTER_C &&
  WW_MINUTE_JETZT >= WW_MORGEN_MINUTE &&
  WW_MINUTE_JETZT < WW_MORGEN_MINUTE + WW_MORGEN_FENSTER_MIN;
if WW_MORGEN_NOETIG {
  log("MORGEN: waere faellig; Ziel", WW_MORGEN_ZIEL_C, "C (keine Aktion)")
} else { false };
// Open-Meteo liefert lokale Stunden-ENDE-Zeitstempel; Stundenwert gilt vorherige 60 Minuten.
let PV_ANTWORT = httpGet("https://api.open-meteo.com/v1/forecast?latitude=52.5200&longitude=13.4050&hourly=global_tilted_irradiance&timezone=Europe%2FBerlin&forecast_days=2&tilt=30&azimuth=0");
let PV_ZEITEN = jsonPath(PV_ANTWORT, "hourly.time");
let PV_WERTE = jsonPath(PV_ANTWORT, "hourly.global_tilted_irradiance");
let PV_DATEN_OK = type(PV_ZEITEN) == "array" && type(PV_WERTE) == "array" &&
  len(PV_ZEITEN) > 0 && len(PV_ZEITEN) <= 192 && len(PV_ZEITEN) == len(PV_WERTE) &&
  jsonPath(PV_ANTWORT, "timezone") == "Europe/Berlin";
let PV_KANDIDATEN = PV_DATEN_OK && PV_FRUEHEST > 0 && PV_ENDE_UNIX >= PV_FRUEHEST ?
  filter(map(0..(len(PV_ZEITEN) - 1), {
    let i = #;
    let wert = PV_WERTE[i];
    let istZahl = type(wert) == "int" || type(wert) == "float";
    let zeit = type(PV_ZEITEN[i]) == "string" ?
      date(PV_ZEITEN[i], WW_DATUM_LAYOUT, "Europe/Berlin") : nil;
    let ende = zeit == nil ? -1 : zeit.Unix();
    let start = max(ende - 3600, PV_FRUEHEST);
    {startUnix: start, score: wert, gueltig: istZahl && wert >= 0 && wert <= 1600 &&
      zeit != nil && start < ende && start <= PV_ENDE_UNIX && wert >= PV_MIN_WERT && wert > 0}
  }), .gueltig) : [];
let PV_SORTIERT = len(PV_KANDIDATEN) > 0 ? sortBy(PV_KANDIDATEN, .score) : [];
let PV_BESTWERT = len(PV_SORTIERT) > 0 ? PV_SORTIERT[-1].score : nil;
let PV_GLEICH = PV_BESTWERT == nil ? [] : filter(PV_KANDIDATEN, .score == PV_BESTWERT);
let PV_BEST = len(PV_GLEICH) > 0 ? sortBy(PV_GLEICH, .startUnix)[0] : nil;
let PV_ERSETZUNG = PV_BEST == nil && WW_FALLBACK == "manual_latest" &&
  PV_ENDE_UNIX >= PV_START_UNIX ? PV_ENDE_UNIX : -1;
let PV_VORSCHLAG_UNIX = PV_BEST == nil ? PV_ERSETZUNG : PV_BEST.startUnix;
let PV_BEDARF = WW_AUTOMATIK_AKTIV && WW_TAGESLADUNG_AKTIV &&
  WW_IST != nil && (type(WW_IST) == "int" || type(WW_IST) == "float") &&
  WW_IST < WW_TAGES_ZIEL_C;
log("PV-Quelle", PV_QUELLE, "Daten formal gueltig", PV_DATEN_OK,
    "passende Startzeiten", len(PV_KANDIDATEN));
if PV_BEST != nil {
  log("PROGNOSE: beste Startzeit des heutigen Tages (kein gespeicherter Plan)",
      date(PV_BEST.startUnix, "", "Europe/Berlin").Format("15:04"),
      "Wert", round(PV_BEST.score * 100) / 100,
      "W/m2 Stundenmittel")
} else if PV_ERSETZUNG > 0 {
  log("RUECKFALL: kein geeigneter Prognose-Slot, geplanter Ersatzzeitpunkt", PV_ENDE,
      "– noch keine Geräteaktion")
} else {
  log("KEIN PV-VORSCHLAG: fehlende Daten, Mindestwert nicht erreicht oder Tagesfenster vorbei")
};
log("Nur Prognose: keine gemessene Netzleistung, keine PV-Deckungsquote.");
// V0.4 Tagesstatus: NUR LESEN. Keine neuen Statuswerte erfinden oder quittieren.
// Ein spaeterer Live-Controller muss atomare Statuswechsel / Zeitnachweise zusaetzlich implementieren.
let WW_MERKER_TAG = get("community_ww_day_v04", "");
let WW_MERKER_MORGEN = get("community_ww_morning_v04", "none");
let WW_MERKER_TAGESSLOT = get("community_ww_main_v04", "none");
let WW_UNGEWISS = WW_MERKER_MORGEN in ["requested", "running", "pending", "unknown"] ||
  WW_MERKER_TAGESSLOT in ["requested", "running", "pending", "unknown"];
let WW_ALT = WW_MERKER_TAG != "" && WW_MERKER_TAG != WW_HEUTE;
let WW_MORGEN_BEREITS = WW_MERKER_TAG == WW_HEUTE && WW_MERKER_MORGEN in ["done", "completed"];
let WW_PV_BEREITS = WW_MERKER_TAG == WW_HEUTE && WW_MERKER_TAGESSLOT in ["done", "completed"];
let WW_STATUS_FEHLER = !(WW_MERKER_MORGEN in ["none", "done", "completed", "requested", "running", "pending", "unknown"]) ||
  !(WW_MERKER_TAGESSLOT in ["none", "done", "completed", "requested", "running", "pending", "unknown"]);
let WW_MORGEN_KANDIDAT = WW_MORGEN_NOETIG && !WW_UNGEWISS && !WW_MORGEN_BEREITS && !WW_STATUS_FEHLER;
// Diagnose: Zeitfenster erreicht, KEINE Freigabe fuer einen Geraetebefehl.
let WW_PV_UHR_JETZT = PV_VORSCHLAG_UNIX > 0 && WW_UNIX >= PV_VORSCHLAG_UNIX &&
  WW_UNIX - PV_VORSCHLAG_UNIX <= 900;
let WW_ZEITPROGRAMM_NEU_PLANBAR = PV_VORSCHLAG_UNIX >= PV_SCHREIB_VORLAUF_UNIX;
// Ohne verbindlich gespeicherten Tagesplan und Ladezustandsnachweis niemals automatisch starten.
let WW_PV_KANDIDAT = false;
log("TAGESSTATUS (lesend): Datum", WW_MERKER_TAG, "Morgen", WW_MERKER_MORGEN,
    "PV", WW_MERKER_TAGESSLOT, "alter Tag", WW_ALT, "unklar", WW_UNGEWISS,
    "Statusfehler", WW_STATUS_FEHLER);
log("DIAGNOSE: PV-Zeitfenster erreicht", WW_PV_UHR_JETZT,
    "Zeitplan HEUTE noch neu schreibbar", WW_ZEITPROGRAMM_NEU_PLANBAR);
log("KANDIDATEN: Morgen", WW_MORGEN_KANDIDAT, "PV", WW_PV_KANDIDAT,
    "NICHT freigegeben: es fehlt ein dauerhaft festgelegter und bestaetigter Tagesplan.");
log("Tagesladung laut Temperatur erforderlich", PV_BEDARF, "Vorschlag Unix", PV_VORSCHLAG_UNIX);
log("KEINE GERÄTEAKTION: Tageszustand wird nur gelesen; kein set(), kein Startbefehl.");
false
